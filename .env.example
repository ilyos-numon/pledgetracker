# 로컬 Supabase (supabase status -o env 값을 넣는다. 주소는 localhost 로 적는다)
SUPABASE_URL=http://localhost:58321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 웹 (Vite)
VITE_SUPABASE_URL=http://localhost:58321
VITE_SUPABASE_ANON_KEY=
VITE_DEFAULT_OFFICIAL=sample-oo-si

# LLM (OpenAI 호환 API). 테스트는 LLM_MODE=fixture 로 네트워크 없이 돈다
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.7-flash
LLM_MODE=live
LLM_FIXTURE_DIR=tests/fixtures/llm

# 공약집 변환 (HWP/HWPX → Markdown)
HWP2MD_CMD="uvx --from hwp2markdown hwp2md"

# n8n (docker compose)
SUPABASE_URL_FOR_N8N=http://host.docker.internal:58321
PLEDGE_OFFICIAL_ID=
EVIDENCE_FEED_URLS=

# Playwright webServer 포트
PW_PORT=8861
