# 운영 배포 입력값. 값은 비워 둔 채 커밋한다 — 이 파일에 실제 값을 적지 않는다.
# 복사해서 쓴다: cp deploy/env.production.example .env.production  (.env.production 은 .gitignore 의 .env.* 로 커밋되지 않는다)
# KEY=VALUE 줄만 읽는다(셸로 실행하지 않는다). 값을 감싼 따옴표 한 쌍은 벗긴다.
# 읽는 스크립트: deploy/gcp/gh-vars.sh · deploy/gcp/push-image.sh · deploy/load-prod.sh

# GCP 프로젝트 ID (콘솔 상단 프로젝트 선택기)
GCP_PROJECT_ID=pladge-tracker-demo-514301
# Cloud Run·Artifact Registry 리전
GCP_REGION=asia-northeast3
# GitHub 저장소 (<owner>/<repo>). GitHub Variables 를 넣을 곳
GITHUB_REPO=ilyos-numon/pledgetracker

# Supabase 프로젝트 주소 https://<SUPABASE_REF>.supabase.co
#   대시보드 → 프로젝트 → Project Settings → General 의 Project ID 가 <SUPABASE_REF>
#   (Project Settings → Data API 의 Project URL 과 같다)
SUPABASE_URL=https://<SUPABASE_REF>.supabase.co
# 공개(anon) 키. 브라우저 번들에 들어가는 공개 값 (VITE_SUPABASE_ANON_KEY 로 빌드에 넣는다)
#   대시보드 → Project Settings → API Keys → Legacy API keys 탭의 anon, 없으면 Publishable key(sb_publishable_…)
SUPABASE_ANON_KEY=
# service_role 키. 비밀 — RLS 를 우회한다. deploy/load-prod.sh 만 쓰고 GitHub·Cloud Run 에는 올리지 않는다
#   대시보드 → Project Settings → API Keys → Legacy API keys 탭의 service_role, 없으면 Secret key(sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=
