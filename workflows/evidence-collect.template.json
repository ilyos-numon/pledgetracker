{
  "id": "pledgeEvidence001",
  "name": "pledge-evidence-collect",
  "active": false,
  "nodes": [
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {}
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000002",
      "name": "Weekly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "parameters": {
        "rule": {
          "interval": [{ "field": "weeks", "weeksInterval": 1, "triggerAtDay": [1], "triggerAtHour": 9, "triggerAtMinute": 0 }]
        }
      }
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000003",
      "name": "Load Pledges",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 100],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL_FOR_N8N }}/rest/v1/pledges?select=id,keywords&official_id=eq.{{ $env.PLEDGE_OFFICIAL_ID }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "options": { "response": { "response": { "responseFormat": "json" } } }
      }
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000004",
      "name": "Feed URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 100],
      "parameters": {
        "jsCode": "// EVIDENCE_FEED_URLS: 쉼표로 구분한 RSS 주소. 비어 있으면 0건.\nconst raw = String($env.EVIDENCE_FEED_URLS ?? '');\nreturn raw.split(',').map((s) => s.trim()).filter((s) => s !== '').map((url) => ({ json: { url } }));\n"
      }
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000005",
      "name": "Read Feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [780, 100],
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {}
      }
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000006",
      "name": "Match Pledges",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 100],
      "parameters": {
        "jsCode": "/*@@MATCH_CODE@@*/"
      }
    },
    {
      "id": "6c1f0e2a-5d00-4b01-8e01-000000000007",
      "name": "Upsert Candidates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL_FOR_N8N }}/rest/v1/evidence_candidates?on_conflict=pledge_id,url",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Prefer", "value": "resolution=ignore-duplicates,return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}",
        "options": { "response": { "response": { "responseFormat": "text" } } }
      }
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "Load Pledges", "type": "main", "index": 0 }]] },
    "Weekly": { "main": [[{ "node": "Load Pledges", "type": "main", "index": 0 }]] },
    "Load Pledges": { "main": [[{ "node": "Feed URLs", "type": "main", "index": 0 }]] },
    "Feed URLs": { "main": [[{ "node": "Read Feed", "type": "main", "index": 0 }]] },
    "Read Feed": { "main": [[{ "node": "Match Pledges", "type": "main", "index": 0 }]] },
    "Match Pledges": { "main": [[{ "node": "Upsert Candidates", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Seoul" },
  "pinData": {}
}
